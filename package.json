{
	"name": "taraskevizer",
	"version": "11.0.0",
	"author": "GooseOb",
	"bin": {
		"tarask": "./dist/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GooseOb/taraskevizer.git"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"node": "./dist/node.js",
			"default": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/node": "^25.9.4",
		"bun-types": "^1.3.14",
		"esbuild": "^0.28.1",
		"husky": "^9.1.7",
		"typescript": "^6.0.3"
	},
	"description": "Канвэртацыя акадэмічнага правапісу ў клясычны",
	"files": [
		"dist",
		"README.md"
	],
	"homepage": "https://gooseob.github.io/taraskevizatar/",
	"keywords": [
		"taraskevizatar",
		"taraskevica",
		"тарашкевіца",
		"тарашкевізатар",
		"belarusian"
	],
	"license": "MIT",
	"private": false,
	"scripts": {
		"build": "wasm-pack build taraskevizer-rs/crates/wasm --target web --out-dir ../../../src/wasm && tsc --noEmit -p tsconfig.json && tsc -p tsconfig.build.json && mkdir -p dist/wasm && cp src/wasm/taraskevizer_wasm.js src/wasm/taraskevizer_wasm.d.ts src/wasm/taraskevizer_wasm_bg.wasm dist/wasm/ && chmod +x dist/cli.js && bun run bundle",
		"postinstall": "node ./dist/install-cli-binary.js || exit 0",
		"prepack": "npm run build",
		"bundle": "esbuild src/bundle.ts --bundle --format=iife --global-name=taraskevizer --target=es2020 --minify --outfile=dist/bundle.js --loader:.wasm=binary --log-level=warning",
		"format": "biome format --write && cargo fmt --all --manifest-path ./taraskevizer-rs/Cargo.toml",
		"lint": "cargo clippy --all-targets --all-features --locked --manifest-path ./taraskevizer-rs/Cargo.toml",
		"test": "cargo test --locked --workspace --manifest-path ./taraskevizer-rs/Cargo.toml",
		"test:wasm": "wasm-pack test --node taraskevizer-rs/crates/wasm",
		"json": "DEST_DIR=json cargo run --locked --manifest-path ./taraskevizer-rs/Cargo.toml -p taraskevizer-core --example gen_dict_json",
		"docs:dev": "cd website && bun run dev",
		"docs:build": "cd website && bun install && bun run build",
		"docs:preview": "cd website && bun run preview"
	},
	"sideEffects": false,
	"type": "module"
}
